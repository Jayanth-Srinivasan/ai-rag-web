"use client"

import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import confetti from "canvas-confetti"

const USE_CASES = [
  "AI Health Assistant",
  "Smart City Traffic System",
  "Fraud Detection Engine",
  "Climate Change Predictor",
  "Autonomous Farming Bot",
  "Virtual Legal Advisor",
]

const TEAM_MAPPING: Record<string, number> = {
  "Team 1": 3,
  "Team 2": 2,
  "Team 3": 5,
}

export default function Page() {
  const [rotation, setRotation] = useState(0)
  const [usedTeams, setUsedTeams] = useState<string[]>([])
  const [selectedUseCase, setSelectedUseCase] = useState("")
  const [open, setOpen] = useState(false)

  const spin = (team: string) => {
    if (usedTeams.includes(team)) return

    const index = TEAM_MAPPING[team]
    const slice = 360 / USE_CASES.length
    const finalRotation = 360 * 6 + (360 - index * slice)

    setRotation(finalRotation)
    setUsedTeams([...usedTeams, team])
    setSelectedUseCase(USE_CASES[index])

    setTimeout(() => {
      setOpen(true)
      confetti({ particleCount: 250, spread: 90, origin: { y: 0.6 } })
    }, 2500)
  }

  return (
    <div className="h-screen w-screen flex flex-col items-center justify-center bg-gradient-to-br from-indigo-50 to-sky-100 overflow-hidden">

      <h1 className="text-4xl font-extrabold mb-8 text-slate-800">
        🎯 Select Your Hackathon Use Case
      </h1>

      <div className="relative w-[560px] h-[560px] mb-16">

        {/* Pointer */}
        <div className="absolute -top-9 left-1/2 -translate-x-1/2 z-20">
          <div className="w-0 h-0 border-l-[22px] border-r-[22px] border-b-[42px] border-l-transparent border-r-transparent border-b-slate-900 drop-shadow-lg" />
        </div>

        {/* Wheel */}
        <div
          className="absolute inset-0 rounded-full shadow-2xl transition-transform duration-[2500ms] ease-out overflow-hidden"
          style={{ transform: `rotate(${rotation}deg)` }}
        >
          {USE_CASES.map((usecase, i) => {
            const angle = 360 / USE_CASES.length
            const rotate = angle * i
            return (
              <div key={i} className="absolute w-full h-full" style={{ transform: `rotate(${rotate}deg)` }}>
                <div
                  className="w-full h-full flex items-start justify-center"
                  style={{
                    background: `hsl(${i * 60}, 75%, 65%)`,
                    clipPath: "polygon(50% 50%, 0 0, 100% 0)",
                  }}
                >
                  <span
                    className="mt-8 w-36 text-center text-sm font-bold text-white drop-shadow"
                    style={{ transform: `rotate(${angle / 2}deg)` }}
                  >
                    {usecase}
                  </span>
                </div>
              </div>
            )
          })}

          {/* Center Hub */}
          <div className="absolute inset-0 flex items-center justify-center">
            <div className="w-28 h-28 bg-white rounded-full shadow-xl flex items-center justify-center text-xl font-bold border-4 border-slate-300">
              SPIN
            </div>
          </div>
        </div>
      </div>

      {/* Team Buttons */}
      <div className="flex gap-8">
        {["Team 1", "Team 2", "Team 3"].map((team) => (
          <Button
            key={team}
            onClick={() => spin(team)}
            disabled={usedTeams.includes(team)}
            className="px-12 py-6 text-lg shadow-lg"
            variant={usedTeams.includes(team) ? "secondary" : "default"}
          >
            {team}
          </Button>
        ))}
      </div>

      {/* Result Dialog */}
      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="text-center">
          <DialogHeader>
            <DialogTitle className="text-2xl">🎉 Selected Use Case</DialogTitle>
          </DialogHeader>
          <p className="mt-4 text-xl font-bold text-slate-700">
            {selectedUseCase}
          </p>
        </DialogContent>
      </Dialog>
    </div>
  )
}
