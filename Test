"use client"

import { useState } from "react"
import { Button } from "@/components/ui/button"
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog"
import confetti from "canvas-confetti"

const USE_CASES = [
  "AI Health Assistant",
  "Smart City Traffic System",
  "Fraud Detection Engine",
  "Climate Change Predictor",
  "Autonomous Farming Bot",
  "Virtual Legal Advisor",
]

const TEAM_MAPPING: Record<string, number> = {
  "Team 1": 3, // Use case 4
  "Team 2": 2, // Use case 3
  "Team 3": 5, // Use case 6
}

export default function Page() {
  const [rotation, setRotation] = useState(0)
  const [usedTeams, setUsedTeams] = useState<string[]>([])
  const [selectedUseCase, setSelectedUseCase] = useState("")
  const [open, setOpen] = useState(false)

  const spinWheel = (team: string) => {
    if (usedTeams.includes(team)) return

    const index = TEAM_MAPPING[team]
    const anglePerSlice = 360 / USE_CASES.length

    // Offset so selected slice aligns with arrow
    const finalAngle = 360 * 6 - index * anglePerSlice

    setRotation(finalAngle)
    setUsedTeams((prev) => [...prev, team])
    setSelectedUseCase(USE_CASES[index])

    setTimeout(() => {
      setOpen(true)
      confetti({
        particleCount: 200,
        spread: 70,
        origin: { y: 0.55 },
      })
    }, 2200)
  }

  return (
    <div className="h-screen w-screen flex flex-col items-center justify-center bg-gray-50 text-gray-900 overflow-hidden">

      <h1 className="text-4xl font-bold mb-10">
        🎯 Use Case Spinner
      </h1>

      {/* Wheel Container */}
      <div className="relative w-[420px] h-[420px] mb-12">

        {/* Arrow */}
        <div className="absolute top-[-14px] left-1/2 -translate-x-1/2 z-20">
          <div className="w-0 h-0 
            border-l-[14px] border-r-[14px] border-b-[26px]
            border-l-transparent border-r-transparent border-b-gray-900" />
        </div>

        {/* Wheel */}
        <div
          className="absolute inset-0 rounded-full border-[10px] border-gray-200 bg-white shadow-lg transition-transform duration-[2200ms] ease-[cubic-bezier(0.22,1,0.36,1)]"
          style={{ transform: `rotate(${rotation}deg)` }}
        />

        {/* Use Cases Outside */}
        {USE_CASES.map((usecase, i) => {
          const angle = (360 / USE_CASES.length) * i
          const radius = 230

          return (
            <div
              key={usecase}
              className="absolute left-1/2 top-1/2"
              style={{
                transform: `
                  rotate(${angle}deg)
                  translateY(-${radius}px)
                  rotate(-${angle}deg)
                `,
              }}
            >
              <div className="px-3 py-1 bg-white border border-gray-300 rounded-full shadow-sm text-sm font-medium whitespace-nowrap">
                {usecase}
              </div>
            </div>
          )
        })}
      </div>

      {/* Team Buttons */}
      <div className="flex gap-6">
        {["Team 1", "Team 2", "Team 3"].map((team) => (
          <Button
            key={team}
            onClick={() => spinWheel(team)}
            disabled={usedTeams.includes(team)}
            className="px-8 py-6 text-lg"
            variant={usedTeams.includes(team) ? "secondary" : "default"}
          >
            {team}
          </Button>
        ))}
      </div>

      {/* Result Dialog */}
      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="text-center">
          <DialogHeader>
            <DialogTitle className="text-2xl">
              🎉 Selected Use Case
            </DialogTitle>
          </DialogHeader>
          <p className="mt-4 text-xl font-semibold">
            {selectedUseCase}
          </p>
        </DialogContent>
      </Dialog>
    </div>
  )
}
