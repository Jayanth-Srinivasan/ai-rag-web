"use client"

import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import confetti from "canvas-confetti"

const USE_CASES = [
  "AI Health Assistant",
  "Smart City Traffic System",
  "Fraud Detection Engine",
  "Climate Change Predictor",
  "Autonomous Farming Bot",
  "Virtual Legal Advisor",
]

const TEAM_MAPPING: Record<string, number> = {
  "Team 1": 3,
  "Team 2": 2,
  "Team 3": 5,
}

export default function Page() {
  const [rotation, setRotation] = useState(0)
  const [usedTeams, setUsedTeams] = useState<string[]>([])
  const [selectedUseCase, setSelectedUseCase] = useState("")
  const [open, setOpen] = useState(false)

  const spin = (team: string) => {
    if (usedTeams.includes(team)) return

    const index = TEAM_MAPPING[team]
    const slice = 360 / USE_CASES.length
    const finalRotation = 360 * 6 + (360 - index * slice)

    setRotation(finalRotation)
    setUsedTeams([...usedTeams, team])
    setSelectedUseCase(USE_CASES[index])

    setTimeout(() => {
      setOpen(true)
      confetti({ particleCount: 160, spread: 60, origin: { y: 0.55 } })
    }, 2200)
  }

  return (
    <div className="h-screen w-screen flex flex-col items-center justify-center bg-slate-50 text-slate-900 overflow-hidden">

      <h1 className="text-4xl font-semibold mb-10 flex items-center gap-3">
        🎯 Select Hackathon Use Case
      </h1>

      <div className="relative w-[560px] h-[560px] mb-14">

        {/* Pointer */}
        <div className="absolute -top-9 left-1/2 -translate-x-1/2 z-20">
          <div className="w-0 h-0 border-l-[20px] border-r-[20px] border-b-[38px] border-l-transparent border-r-transparent border-b-slate-900 drop-shadow" />
        </div>

        {/* Wheel */}
        <div
          className="absolute inset-0 rounded-full shadow-xl transition-transform duration-[2200ms] ease-out overflow-hidden bg-white border border-slate-200"
          style={{ transform: `rotate(${rotation}deg)` }}
        >
          {USE_CASES.map((usecase, i) => {
            const angle = 360 / USE_CASES.length
            const rotate = angle * i
            return (
              <div key={i} className="absolute w-full h-full" style={{ transform: `rotate(${rotate}deg)` }}>
                <div
                  className="w-full h-full flex items-start justify-center"
                  style={{
                    background: i % 2 === 0 ? "#f1f5f9" : "#e2e8f0",
                    clipPath: "polygon(50% 50%, 0 0, 100% 0)",
                  }}
                >
                  <span
                    className="mt-10 w-40 text-center text-sm font-medium text-slate-700"
                    style={{ transform: `rotate(${angle / 2}deg)` }}
                  >
                    {usecase}
                  </span>
                </div>
              </div>
            )
          })}

          {/* Center Hub */}
          <div className="absolute inset-0 flex items-center justify-center">
            <div className="w-24 h-24 bg-white rounded-full shadow border border-slate-300 flex items-center justify-center text-lg font-semibold">
              SPIN
            </div>
          </div>
        </div>
      </div>

      {/* Controls */}
      <div className="flex gap-6">
        {["Team 1", "Team 2", "Team 3"].map((team) => (
          <Button
            key={team}
            onClick={() => spin(team)}
            disabled={usedTeams.includes(team)}
            className="px-10 py-5 text-lg"
            variant={usedTeams.includes(team) ? "secondary" : "default"}
          >
            {team}
          </Button>
        ))}
      </div>

      {/* Result */}
      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="text-center">
          <DialogHeader>
            <DialogTitle className="text-2xl">Selected Use Case</DialogTitle>
          </DialogHeader>
          <p className="mt-4 text-xl font-semibold">{selectedUseCase}</p>
        </DialogContent>
      </Dialog>
    </div>
  )
}
