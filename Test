"use client"

import { useState } from "react"
import { Button } from "@/components/ui/button"
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import confetti from "canvas-confetti"

const USE_CASES = [
  "AI Health Assistant",
  "Smart City Traffic System",
  "Fraud Detection Engine",
  "Climate Change Predictor",
  "Autonomous Farming Bot",
  "Virtual Legal Advisor",
]

const TEAM_MAPPING: Record<string, number> = {
  "Team 1": 3,
  "Team 2": 2,
  "Team 3": 5,
}

export default function Page() {
  const [rotation, setRotation] = useState(0)
  const [usedTeams, setUsedTeams] = useState<string[]>([])
  const [selectedUseCase, setSelectedUseCase] = useState("")
  const [open, setOpen] = useState(false)

  const spinWheel = (team: string) => {
    if (usedTeams.includes(team)) return

    const index = TEAM_MAPPING[team]
    const slice = 360 / USE_CASES.length
    const finalAngle = 360 * 6 - index * slice

    setRotation(finalAngle)
    setUsedTeams([...usedTeams, team])
    setSelectedUseCase(USE_CASES[index])

    setTimeout(() => {
      setOpen(true)
      confetti({ particleCount: 220, spread: 80, origin: { y: 0.6 } })
    }, 2200)
  }

  return (
    <div className="h-screen w-screen flex flex-col items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200 overflow-hidden">

      <h1 className="text-4xl font-extrabold mb-10 text-slate-800 flex items-center gap-3">
        🎯 <span>Use Case Spinner</span>
      </h1>

      <div className="relative w-[440px] h-[440px] mb-12">

        {/* Arrow */}
        <div className="absolute -top-7 left-1/2 -translate-x-1/2 z-30">
          <div className="w-0 h-0 border-l-[18px] border-r-[18px] border-b-[36px] border-l-transparent border-r-transparent border-b-slate-900 drop-shadow-lg" />
        </div>

        {/* Wheel */}
        <div
          className="absolute inset-0 rounded-full shadow-2xl transition-transform duration-[2200ms] ease-[cubic-bezier(0.22,1,0.36,1)] overflow-hidden bg-white"
          style={{ transform: `rotate(${rotation}deg)` }}
        >
          {USE_CASES.map((_, i) => {
            const angle = 360 / USE_CASES.length
            return (
              <div key={i} className="absolute w-full h-full origin-center" style={{ transform: `rotate(${angle * i}deg)` }}>
                <div
                  className="w-full h-full"
                  style={{
                    clipPath: "polygon(50% 50%, 0 0, 100% 0)",
                    background: `hsl(${i * 60}, 70%, 80%)`,
                  }}
                />
              </div>
            )
          })}

          {/* Center Hub */}
          <div className="absolute inset-0 flex items-center justify-center">
            <div className="w-20 h-20 rounded-full bg-white shadow-xl border-4 border-slate-300" />
          </div>
        </div>

        {/* Labels */}
        {USE_CASES.map((usecase, i) => {
          const angle = (360 / USE_CASES.length) * i
          const radius = 260
          return (
            <div
              key={usecase}
              className="absolute left-1/2 top-1/2"
              style={{ transform: `rotate(${angle}deg) translateY(-${radius}px) rotate(-${angle}deg)` }}
            >
              <div className="px-4 py-1.5 bg-white border border-slate-300 rounded-full shadow-md text-sm font-semibold whitespace-nowrap">
                {usecase}
              </div>
            </div>
          )
        })}
      </div>

      <div className="flex gap-6">
        {["Team 1", "Team 2", "Team 3"].map((team) => (
          <Button
            key={team}
            onClick={() => spinWheel(team)}
            disabled={usedTeams.includes(team)}
            className="px-10 py-6 text-lg font-semibold shadow-md"
            variant={usedTeams.includes(team) ? "secondary" : "default"}
          >
            {team}
          </Button>
        ))}
      </div>

      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="text-center">
          <DialogHeader>
            <DialogTitle className="text-2xl">🎉 Selected Use Case</DialogTitle>
          </DialogHeader>
          <p className="mt-4 text-xl font-bold text-slate-700">{selectedUseCase}</p>
        </DialogContent>
      </Dialog>
    </div>
  )
}
